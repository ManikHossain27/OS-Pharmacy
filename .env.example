# =============================================================================
# PMS Automation - environment configuration (SAMPLE - no secrets)
# Copy to .env and fill in real values.  .env is git-ignored.
# =============================================================================

# Which environment the run targets: local | staging | prod
TEST_ENV=staging

# Base URLs per environment
LOCAL_BASE_URL=http://localhost:3000
STAGING_BASE_URL=https://pms-sql-portal.ems24.co/
PROD_BASE_URL=

# Credentials.
# NOTE: the login form field is labelled "Phone number" but currently also
# accepts an email address (vendor said phone-only login lands later).
LOGIN_PHONE=
LOGIN_PASSWORD=

# Pharmacy that every test must run inside
PHARMACY_NAME=Manik Pharma

# Browser / runtime
HEADLESS=true
BROWSER=chromium
DEFAULT_TIMEOUT=30000
NAV_TIMEOUT=45000
SLOW_MO=0

# Safety switch: destructive tests (delete/permanent-edit of QA data) only run
# when this is true AND TEST_ENV != prod.
RUN_DESTRUCTIVE_TESTS=false

# Reuse a saved auth session (Playwright storage_state) between runs
REUSE_AUTH_STATE=true
